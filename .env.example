# Base de dados (Railway PostgreSQL ou local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/casadaserra?schema=public"

# Servidor
PORT=3001
NODE_ENV=development

# JWT (muda para uma string longa e aleatória)
JWT_SECRET="muda-esta-chave-para-algo-seguro-em-producao"

# Admin inicial (usado no seed)
ADMIN_EMAIL="admin@casadaserra.pt"
ADMIN_PASSWORD="muda-esta-password"
ADMIN_NAME="Administrador"
# Email que recebe os avisos de reservas e as mensagens de contacto (por omissão: reservas@casadoferreirovn.pt)
NOTIFICATION_EMAIL="reservas@casadoferreirovn.pt"

# Email via API do Resend (recomendado no Railway, que bloqueia SMTP fora do plano Pro).
# Com esta chave definida, o SMTP abaixo é ignorado. EMAIL_FROM tem de usar o domínio verificado no Resend.
RESEND_API_KEY="re_..."

# Email (Nodemailer via Gmail ou SMTP próprio)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="reservas@casadaserra.pt"
SMTP_PASS="app-password-do-gmail"
EMAIL_FROM="Casa da Serra <reservas@casadaserra.pt>"

# Stripe (pagamentos)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Domínios autorizados a usar a API no browser (separados por vírgula)
ALLOWED_ORIGINS="https://rfcbraz.github.io,https://casadoferreirovn.pt,https://www.casadoferreirovn.pt"

# Verificação anti-robô Cloudflare Turnstile (Secret Key)
TURNSTILE_SECRET_KEY="..."

# Frontend URL (links de pagamento e emails)
FRONTEND_URL="http://localhost:5500"
