{
  "name": "casadaserra-backend",
  "version": "1.0.0",
  "description": "Backend API para Casa do Ferreiro",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node start.js",
    "build": "echo 'No build needed for static site'",
    "postinstall": "node ./node_modules/prisma/build/index.js generate",
    "db:check": "node scripts/check-db.js",
    "db:setup": "npm run db:check && npx prisma migrate deploy && node src/seed.js",
    "db:migrate": "npx prisma migrate deploy",
    "db:studio": "npx prisma studio",
    "db:seed": "node src/seed.js",
    "emails": "node scripts/preview-emails.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
