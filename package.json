{
  "name": "casadaserra-backend",
  "version": "1.0.0",
  "description": "Backend API para Casa do Ferreiro",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node start.js",
    "build": "echo 'No build needed for static site'",
    "postinstall": "node ./node_modules/prisma/build/index.js generate",
    "db:check": "node scripts/check-db.js",
    "db:setup": "npm run db:check && npx prisma migrate deploy && node src/seed.js",
    "db:migrate": "npx prisma migrate deploy",
    "db:studio": "npx prisma studio",
    "db:seed": "node src/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.2",
    "prisma": "^5.22.0",
    "stripe": "^14.21.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
