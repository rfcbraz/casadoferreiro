// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // endereço em prisma.config.mjs (DATABASE_URL)
}

model Room {
  id             String   @id @default(uuid())
  name           String   @unique
  type           String
  description    String
  pricePerNight  Float
  weekendPrice   Float? // preço das noites de sexta e sábado fora de épocas
  capacity       Int
  baseOccupancy  Int? // pessoas incluídas no preço base (T2: 4, T3: 6)
  fewerGuestDiscountPct Float @default(0) // % de desconto por cada pessoa a menos
  extraGuestFee  Float @default(0) // € por noite por cada pessoa a mais
  cribFeePerNight Float @default(0) // € por noite por berço (bebés 0–2)
  sizeSqm        Float?
  bedrooms       Int?
  beds           Int?
  amenities      String[]
  images         String[]
  bookingIcalUrl String?
  airbnbIcalUrl  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reservations Reservation[]
  blockedDates BlockedDate[]
  priceRules   PriceRule[]
  promotions   Promotion[]
}

// Definições gerais do painel (ex.: cribsTotal = número de berços partilhados pelas casas)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// Berços em uso registados à mão (ex.: reservas do Booking/Airbnb com bebé), de startDate até endDate (dia de saída)
model CribHold {
  id        String   @id @default(uuid())
  startDate DateTime // primeira noite
  endDate   DateTime // dia de saída (não conta)
  cribs     Int
  note      String   @default("")
  createdAt DateTime @default(now())
}

// Promoções: desconto em % para estadias com um mínimo de noites, num período
model Promotion {
  id          String   @id @default(uuid())
  name        String
  startDate   DateTime // primeira noite abrangida
  endDate     DateTime // última noite abrangida (inclusive)
  discountPct Float
  minNights   Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String? // vazio = todas as unidades
}

// Preços por datas: épocas (com preço de fim de semana opcional) e feriados
model PriceRule {
  id           String        @id @default(uuid())
  name         String
  kind         PriceRuleKind
  startDate    DateTime      // primeira noite
  endDate      DateTime      // última noite (inclusive)
  price        Float
  weekendPrice Float?
  createdAt    DateTime      @default(now())

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
}

enum PriceRuleKind {
  SEASON
  HOLIDAY
}

model Guest {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())

  reservations Reservation[]
}

model Reservation {
  id              String            @id @default(uuid())
  checkIn         DateTime
  checkOut        DateTime
  nights          Int
  guests          Int // adultos + 7–17 + 3–6 (bebés não contam)
  adults          Int               @default(0)
  teens           Int               @default(0) // 7–17 anos
  children        Int               @default(0) // 3–6 anos
  infants         Int               @default(0) // 0–2 anos
  cribs           Int               @default(0) // berços pedidos (0 até ao número de bebés)
  priceBreakdown  Json?
  totalPrice      Float
  status          ReservationStatus @default(PENDING)
  breakfast       Boolean           @default(true)
  specialRequests String?
  contactName     String? // nome indicado neste pedido
  contactPhone    String? // telefone indicado neste pedido
  locale          String   @default("pt") // idioma dos emails para o hóspede (pt, en, es)
  stripePaymentId String?
  stripeCheckoutSessionId String?   @unique
  stripeRefundId  String?           @unique
  paymentExpiresAt DateTime?
  paidAt          DateTime?
  notes           String? // notas internas do dono
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  room   Room   @relation(fields: [roomId], references: [id])
  roomId String

  guest   Guest  @relation(fields: [guestId], references: [id])
  guestId String
}

model BlockedDate {
  id          String            @id @default(uuid())
  date        DateTime
  reason      String?
  source      BlockedDateSource @default(MANUAL)
  externalUid String?
  createdAt   DateTime          @default(now())

  room   Room   @relation(fields: [roomId], references: [id])
  roomId String

  @@unique([roomId, date])
}

enum BlockedDateSource {
  MANUAL
  BOOKING_COM
  AIRBNB
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  passwordChangedAt DateTime? // sessões emitidas antes desta data deixam de ser válidas
  createdAt DateTime @default(now())
}

enum ReservationStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
  PAID
}
